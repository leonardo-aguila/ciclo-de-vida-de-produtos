# Copie para .env.local. Nenhum destes valores é real — troque todos.

# A aplicação conecta com o papel sem privilégio de superusuário.
DATABASE_URL="postgresql://portfolio_app:TROQUE_ESTA_SENHA@localhost:5433/portfolio"

# As migrations e o seed rodam como dono do banco. Em desenvolvimento costuma
# ser o seu usuário do sistema; no servidor, o POSTGRES_USER do container.
MIGRATION_DATABASE_URL="postgresql://SEU_USUARIO@localhost:5433/portfolio"

# Banco dos testes de integração. As credenciais da aplicação para este banco
# são derivadas de DATABASE_URL em tests/integration/setup.ts — só preencha
# TEST_APP_DATABASE_URL se o seu arranjo for diferente.
TEST_DATABASE_URL="postgresql://SEU_USUARIO@localhost:5433/portfolio_test"

# Cluster local gerido por scripts/ensure-db.sh (só em desenvolvimento).
PGDATA_DIR="$HOME/.local/pgdata-portfolio"
PGPORT=5433

SESSION_COOKIE_NAME="portfolio_session"
