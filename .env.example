# App connects as the non-superuser role
DATABASE_URL="postgresql://portfolio_app:portfolio_app@localhost:5433/portfolio"
# Migrations run as the cluster superuser
MIGRATION_DATABASE_URL="postgresql://leonardo.aguila@localhost:5433/portfolio"
# Integration tests
TEST_DATABASE_URL="postgresql://leonardo.aguila@localhost:5433/portfolio_test"
# Postgres cluster managed by scripts/ensure-db.sh
PGDATA_DIR="$HOME/.local/pgdata-ponteiro"
PGPORT=5433
SESSION_COOKIE_NAME="portfolio_session"
